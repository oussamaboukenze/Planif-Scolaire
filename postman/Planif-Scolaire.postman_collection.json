              "pm.collectionVariables.set(\"coursId\", pm.response.json().id);",
              "pm.test(\"Cours planifie\", () => pm.expect(pm.response.json().statut).to.eql(\"PLANIFIE\"));"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"coursIdempotencyKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        }
      ]
    },
