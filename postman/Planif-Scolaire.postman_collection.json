    {
      "name": "26 Gateway rate limit retourne 429",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Client-Id",
            "value": "{{rateLimitClientId}}"
          }
        ],
        "url": "{{gatewayUrl}}/api/classes"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"rateLimitClientId\", \"postman-\" + Date.now().toString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const endpoint = pm.variables.replaceIn(\"{{gatewayUrl}}/api/classes\");",
              "const clientId = pm.collectionVariables.get(\"rateLimitClientId\");",
              "const statuses = [];",
              "let completed = 0;",
              "for (let index = 0; index < 12; index++) {",
              "  pm.sendRequest({ url: endpoint, header: { \"X-Client-Id\": clientId } }, (error, response) => {",
              "    statuses.push(error ? 0 : response.code);",
              "    completed++;",
              "    if (completed === 12) { pm.test(\"Token bucket refuse le burst\", () => pm.expect(statuses).to.include(429)); }",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
