            "key": "idempotencyKey",
            "value": "{{coursIdempotencyKey}}",
            "type": "text"
          }
        ],
        "url": "{{planningUrl}}/api/cours",
        "body": {
          "mode": "raw",
          "raw": "{\"classeId\": {{classeId}}, \"enseignantId\": {{enseignantId}}, \"matiere\": \"Maths\", \"dateHeure\": \"2026-11-02T09:00:00\", \"salle\": \"Salle {{runId}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
