              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Erreur explicite\", () => { const e = pm.response.json(); pm.expect(e.status).to.eql(400); pm.expect(e.detail).to.be.a(\"string\").and.not.empty; });"
            ]
          }
        }
      ]
    },
