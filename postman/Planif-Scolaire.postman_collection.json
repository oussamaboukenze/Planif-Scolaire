    {
      "name": "15 Attendre la feuille appel",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{presencesUrl}}/api/appels/cours/{{coursId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const n = Number(pm.collectionVariables.get(\"tentatives\") || 0);",
              "if (pm.response.code === 404 && n < 30) {",
              "  pm.collectionVariables.set(\"tentatives\", n + 1);",
              "  pm.execution.setNextRequest(pm.info.requestName);",
              "} else {",
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"appelId\", pm.response.json().id);",
              "pm.test(\"Appel du cours\", () => pm.expect(String(pm.response.json().coursId)).to.eql(String(pm.collectionVariables.get(\"coursId\"))));",
              "  pm.collectionVariables.set(\"tentatives\", 0);",
              "}"
            ]
          }
        }
      ]
    },
