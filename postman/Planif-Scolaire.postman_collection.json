{
  "info": {
    "name": "Planif-Scolaire V5-V6",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Executer les 26 requetes dans l'ordre avec un delai de 1000 ms. Les services, Kafka, Redis et Mailpit doivent etre demarres. Chaque execution cree ses propres donnees."
  },
  "variable": [
    {
      "key": "referentielUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "planningUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "presencesUrl",
      "value": "http://localhost:8083"
    },
    {
      "key": "notificationUrl",
      "value": "http://localhost:8084"
    },
    {
      "key": "gatewayUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "utilisateursUrl",
      "value": "http://localhost:8085"
    }
  ],
  "item": [
    {
      "name": "01 Creer une classe",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{referentielUrl}}/api/classes",
        "body": {
          "mode": "raw",
          "raw": "{\"nom\": \"Classe {{runId}}\", \"niveau\": \"6e\", \"effectifMax\": 30}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"runId\", Date.now().toString());",
              "pm.collectionVariables.set(\"tentatives\", 0);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Ressource creee\", () => { pm.expect(pm.response.json().id).to.be.above(0); pm.response.to.have.header(\"Location\"); });",
              "pm.collectionVariables.set(\"classeId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Lire la classe",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{referentielUrl}}/api/classes/{{classeId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Classe sauvegardee\", () => pm.expect(pm.response.json().effectifMax).to.eql(30));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Modifier la classe",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{referentielUrl}}/api/classes/{{classeId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"nom\": \"Classe {{runId}}\", \"niveau\": \"6e\", \"effectifMax\": 32}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Modification\", () => pm.expect(pm.response.json().effectifMax).to.eql(32));"
            ]
          }
        }
      ]
    },
