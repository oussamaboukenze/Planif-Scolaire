    {
      "name": "POST 13 Cours (email a Karim)",
      "request": {
        "method": "POST",
        "url": "{{planningUrl}}/api/cours",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "idempotencyKey",
            "value": "demo-{{$guid}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"classeId\": 1002, \"enseignantId\": 1001, \"matiere\": \"Microservices\", \"dateHeure\": \"2026-12-{{jour}}T09:00:00\", \"salle\": \"Amphi {{$timestamp}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"jour\", String(10 + Math.floor(Math.random() * 18)).padStart(2, \"0\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
