      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Données de démo présentes\", () => pm.expect(pm.response.json().map(c => c.id)).to.include(1001));"
            ]
          }
        }
      ]
    },
